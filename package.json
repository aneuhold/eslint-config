{
  "name": "@aneuhold/eslint-config",
  "version": "3.0.4",
  "description": "Main ESLint Configuration for personal projects",
  "main": "./src/configs/ts-lib-config.ts",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "nodemon -e ts --exec \"local-npm publish\"",
    "unpub": "local-npm unpublish",
    "pushpub": "pnpm version patch && git push",
    "upgrade:all": "pnpm update --latest",
    "check": "tsc --noEmit",
    "lint": "pnpm eslint",
    "test": "vitest run"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aneuhold/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "prettier"
  ],
  "author": "Anton G. Neuhold Jr.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aneuhold/eslint-config/issues"
  },
  "homepage": "https://github.com/aneuhold/eslint-config#readme",
  "files": [
    "src/**/*"
  ],
  "peerDependencies": {
    "eslint": ">= 10.12.0",
    "prettier": ">= 3.9.10"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript-eslint/utils": "^8.71.1",
    "angular-eslint": "^22.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.2.4",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript-eslint": "^8.71.1"
  },
  "devDependencies": {
    "@aneuhold/local-npm-registry": "^1.0.3",
    "@aneuhold/robot-instructions": "^0.4.1",
    "@types/node": "^25.9.9",
    "@typescript-eslint/rule-tester": "^8.71.1",
    "eslint": "^10.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "svelte": "^5.56.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
